<Window x:Class="DualSenseLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Great Controller Emulator" Height="900" Width="1480" MinHeight="760" MinWidth="1180"
        Background="#090C13" Foreground="#F4F6FC" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121722"/>
        <SolidColorBrush x:Key="Panel2" Color="#192131"/>
        <SolidColorBrush x:Key="Accent" Color="#8878FF"/>
        <SolidColorBrush x:Key="Muted" Color="#98A4B8"/>
        <SolidColorBrush x:Key="Line" Color="#263044"/>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display"/><Setter Property="Foreground" Value="#F4F6FC"/></Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="Foreground" Value="#F4F6FC"/>
            <Setter Property="Background" Value="#20293A"/><Setter Property="BorderBrush" Value="#303B50"/>
            <Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#2A354A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value=".78"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value=".42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="#A49AFF"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#9D3E58"/><Setter Property="BorderBrush" Value="#C65A76"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="15,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="#C7D0E0"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,6"/><Setter Property="Background" Value="#20293A"/><Setter Property="Foreground" Value="#111620"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="0,7"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,6"/><Setter Property="Background" Value="#192131"/><Setter Property="Foreground" Value="#F4F6FC"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D7DEEB"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="Margin" Value="0,5"/></Style>
        <Style TargetType="ProgressBar"><Setter Property="Background" Value="#20293A"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#0D121B" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#151D2A" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,10">
                        <StackPanel><TextBlock x:Name="SideInputTitle" Text="INPUT ACTIVE" Foreground="#55D6A5" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock x:Name="SideInputNote" Text="ViGEm output is opt-in" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Button x:Name="ResetEffectsNavButton" Style="{StaticResource DangerButton}" Content="Reset Effects" Click="ResetEffects_Click" ToolTip="Immediately disables both adaptive trigger effects."/>
                </StackPanel>
                <StackPanel>
                    <Border Background="#24204A" BorderBrush="#4B4388" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,22">
                        <StackPanel><TextBlock Text="GCE" Foreground="#B9B1FF" FontSize="13" FontWeight="Bold"/><TextBlock Text="Controller Lab" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock Text="DUALSENSE TOOLKIT" Foreground="#8793A8" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                    <TextBlock Text="WORKSPACE" Style="{StaticResource Caption}" Margin="4,0,0,6"/>
                    <Button Style="{StaticResource NavButton}" Content="Dashboard" Tag="0" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Adaptive Triggers" Tag="1" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Stick Calibration" Tag="2" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Input Tester" Tag="3" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Profiles" Tag="4" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Settings" Tag="5" Click="Navigate_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#0D121B" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#15251F" BorderBrush="#245943" BorderThickness="1" CornerRadius="14" Padding="12,6">
                        <StackPanel Orientation="Horizontal"><Ellipse Fill="#55D6A5" Height="8" Width="8" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionHeaderText" Text="Controller connected" Foreground="#BDE9D7" FontSize="12"/></StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TabControl x:Name="Pages" Grid.Row="1" Background="#090C13" BorderThickness="0" Padding="28" SelectionChanged="Pages_SelectionChanged">
                <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Controller overview" FontSize="28" FontWeight="Light"/><TextBlock Text="Live status, connection capabilities, and a quick health snapshot." Style="{StaticResource Caption}" Margin="0,6,0,20"/>
                        <WrapPanel>
                            <Border Style="{StaticResource Card}" Width="330"><StackPanel><TextBlock Text="CONNECTED CONTROLLER" Style="{StaticResource Caption}"/><TextBlock x:Name="ConnectedControllerName" Text="Controller" FontSize="20" Margin="0,10,0,6"/><TextBlock x:Name="ConnectedControllerId" Text="Detecting..." Foreground="#A99FFF"/><TextBlock x:Name="ConnectionModeText" Text="Detecting connection" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="230"><StackPanel><TextBlock Text="BATTERY" Style="{StaticResource Caption}"/><TextBlock x:Name="BatteryText" Text="N/A" FontSize="36" Margin="0,8,0,0"/><ProgressBar x:Name="BatteryProgress" Value="0" Height="5" Margin="0,12,0,0" Foreground="#55D6A5"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="300"><StackPanel><TextBlock Text="OUTPUT SUPPORT" Style="{StaticResource Caption}"/><TextBlock x:Name="OutputSupportTitle" Text="Detecting..." FontSize="20" Margin="0,10,0,5"/><TextBlock x:Name="OutputSupportText" Text="Checking controller capabilities." Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel></Border>
                        </WrapPanel>
                        <TextBlock Text="Live input" Style="{StaticResource SectionTitle}" Margin="0,8,0,12"/>
                        <WrapPanel>
                            <Border Style="{StaticResource Card}" Width="330"><StackPanel><TextBlock Text="LEFT STICK" Style="{StaticResource Caption}"/><TextBlock x:Name="DashboardLeftStick" Text="X  0.000    Y  0.000" FontSize="22" Margin="0,12,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="330"><StackPanel><TextBlock Text="RIGHT STICK" Style="{StaticResource Caption}"/><TextBlock x:Name="DashboardRightStick" Text="X  0.000    Y  0.000" FontSize="22" Margin="0,12,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="330"><StackPanel><TextBlock Text="ACTIVE BUTTONS" Style="{StaticResource Caption}"/><TextBlock x:Name="DashboardButtons" Text="None" FontSize="22" Margin="0,12,0,0"/></StackPanel></Border>
                        </WrapPanel>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Adaptive trigger editor" FontSize="28" FontWeight="Light"/><TextBlock Text="Configure each trigger independently. Valid changes are applied live." Style="{StaticResource Caption}" Margin="0,6,0,20"/>
                        <Border Background="#2D2430" BorderBrush="#7A5361" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16"><TextBlock Text="Safety note: physical trigger effects are active on connected DualSense hardware. Use Reset Effects at any time to withdraw both trigger actuators."/></Border>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="LEFT TRIGGER (L2)" Style="{StaticResource SectionTitle}"/><TextBlock Text="Preset" Style="{StaticResource Caption}"/><ComboBox x:Name="LeftPreset" SelectionChanged="Trigger_ValueChanged"/>
                                <TextBlock Text="Resistance starts" Style="{StaticResource Caption}" Margin="0,9,0,0"/><Slider x:Name="LeftStart" Minimum="0" Maximum="99" Value="20" TickFrequency="5" ValueChanged="Slider_ValueChanged"/><TextBlock x:Name="LeftStartLabel" Text="20%"/>
                                <TextBlock Text="Resistance ends" Style="{StaticResource Caption}" Margin="0,9,0,0"/><Slider x:Name="LeftEnd" Minimum="1" Maximum="100" Value="80" TickFrequency="5" ValueChanged="Slider_ValueChanged"/><TextBlock x:Name="LeftEndLabel" Text="80%"/>
                                <TextBlock Text="Strength" Style="{StaticResource Caption}" Margin="0,9,0,0"/><Slider x:Name="LeftStrength" Minimum="0" Maximum="100" Value="35" TickFrequency="5" ValueChanged="Slider_ValueChanged"/><TextBlock x:Name="LeftStrengthLabel" Text="35%"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="RIGHT TRIGGER (R2)" Style="{StaticResource SectionTitle}"/><TextBlock Text="Preset" Style="{StaticResource Caption}"/><ComboBox x:Name="RightPreset" SelectionChanged="Trigger_ValueChanged"/>
                                <TextBlock Text="Resistance starts" Style="{StaticResource Caption}" Margin="0,9,0,0"/><Slider x:Name="RightStart" Minimum="0" Maximum="99" Value="20" TickFrequency="5" ValueChanged="Slider_ValueChanged"/><TextBlock x:Name="RightStartLabel" Text="20%"/>
                                <TextBlock Text="Resistance ends" Style="{StaticResource Caption}" Margin="0,9,0,0"/><Slider x:Name="RightEnd" Minimum="1" Maximum="100" Value="80" TickFrequency="5" ValueChanged="Slider_ValueChanged"/><TextBlock x:Name="RightEndLabel" Text="80%"/>
                                <TextBlock Text="Strength" Style="{StaticResource Caption}" Margin="0,9,0,0"/><Slider x:Name="RightStrength" Minimum="0" Maximum="100" Value="35" TickFrequency="5" ValueChanged="Slider_ValueChanged"/><TextBlock x:Name="RightStrengthLabel" Text="35%"/></StackPanel></Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal"><Button Content="Reset both triggers" Click="ResetEffects_Click"/><TextBlock x:Name="TriggerStatus" Text="Valid changes apply live." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#98A1B5"/></StackPanel>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Stick calibration" FontSize="28" FontWeight="Light"/><TextBlock Text="Run a timed sample and tune software correction. This does not physically repair stick drift." Style="{StaticResource Caption}" Margin="0,6,0,20"/>
                        <WrapPanel>
                            <Border Style="{StaticResource Card}" Width="380"><StackPanel><TextBlock Text="DRIFT DETECTION WIZARD" Style="{StaticResource SectionTitle}"/><TextBlock Text="Leave the sticks untouched, then run a 4-second center sample." TextWrapping="Wrap" Foreground="#BCC4D5"/><Button x:Name="RunCalibrationButton" Style="{StaticResource PrimaryButton}" Content="Run center calibration" Margin="0,16,0,0" Click="RunCalibration_Click"/><TextBlock x:Name="CalibrationStatus" Text="Ready to sample" Foreground="#98A1B5" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="380"><StackPanel><TextBlock Text="LAST REPORT" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="CalibrationMetrics" Text="No calibration report yet." Foreground="#BCC4D5" TextWrapping="Wrap"/><Button Content="Export diagnostics report" Margin="0,16,0,0" Click="ExportDiagnostics_Click"/></StackPanel></Border>
                        </WrapPanel>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SOFTWARE MITIGATION" Style="{StaticResource SectionTitle}"/><TextBlock Text="Correction affects mapped output. Games receive it while ViGEm virtual-controller output is enabled." Foreground="#E0B669" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="LEFT STICK" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Deadzone" Style="{StaticResource Caption}"/><Slider x:Name="DeadzoneSlider" Minimum="0" Maximum=".4" Value=".08" TickFrequency=".01" ValueChanged="Mitigation_ValueChanged"/><TextBlock x:Name="DeadzoneLabel" Text="8%"/>
                                    <TextBlock Text="Anti-deadzone" Style="{StaticResource Caption}" Margin="0,8,0,0"/><Slider x:Name="AntiDeadzoneSlider" Minimum="0" Maximum=".3" Value="0" TickFrequency=".01" ValueChanged="Mitigation_ValueChanged"/><TextBlock x:Name="AntiDeadzoneLabel" Text="0%"/>
                                    <TextBlock Text="Smoothing" Style="{StaticResource Caption}" Margin="0,8,0,0"/><Slider x:Name="SmoothingSlider" Minimum="0" Maximum=".6" Value=".12" TickFrequency=".01" ValueChanged="Mitigation_ValueChanged"/><TextBlock x:Name="SmoothingLabel" Text="12%"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="RIGHT STICK" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Deadzone" Style="{StaticResource Caption}"/><Slider x:Name="RightDeadzoneSlider" Minimum="0" Maximum=".4" Value=".08" TickFrequency=".01" ValueChanged="Mitigation_ValueChanged"/><TextBlock x:Name="RightDeadzoneLabel" Text="8%"/>
                                    <TextBlock Text="Anti-deadzone" Style="{StaticResource Caption}" Margin="0,8,0,0"/><Slider x:Name="RightAntiDeadzoneSlider" Minimum="0" Maximum=".3" Value="0" TickFrequency=".01" ValueChanged="Mitigation_ValueChanged"/><TextBlock x:Name="RightAntiDeadzoneLabel" Text="0%"/>
                                    <TextBlock Text="Smoothing" Style="{StaticResource Caption}" Margin="0,8,0,0"/><Slider x:Name="RightSmoothingSlider" Minimum="0" Maximum=".6" Value=".12" TickFrequency=".01" ValueChanged="Mitigation_ValueChanged"/><TextBlock x:Name="RightSmoothingLabel" Text="12%"/>
                                </StackPanel>
                            </Grid></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Input tester" FontSize="28" FontWeight="Light"/><TextBlock Text="Real-time input for sticks, buttons, triggers, motion sensors, and touchpad." Style="{StaticResource Caption}" Margin="0,6,0,20"/>
                        <WrapPanel>
                            <Border Style="{StaticResource Card}" Width="310"><StackPanel><TextBlock Text="LEFT STICK X / Y" Style="{StaticResource SectionTitle}"/><Canvas Width="250" Height="250" Background="#0F131D"><Line X1="125" X2="125" Y1="0" Y2="250" Stroke="#343C50"/><Line X1="0" X2="250" Y1="125" Y2="125" Stroke="#343C50"/><Ellipse x:Name="LeftDot" Width="14" Height="14" Fill="#7C6CFF"/></Canvas></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="310"><StackPanel><TextBlock Text="RIGHT STICK X / Y" Style="{StaticResource SectionTitle}"/><Canvas Width="250" Height="250" Background="#0F131D"><Line X1="125" X2="125" Y1="0" Y2="250" Stroke="#343C50"/><Line X1="0" X2="250" Y1="125" Y2="125" Stroke="#343C50"/><Ellipse x:Name="RightDot" Width="14" Height="14" Fill="#55D6A5"/></Canvas></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="350"><StackPanel><TextBlock Text="LIVE SENSOR DATA" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="MotionText" Foreground="#BCC4D5" TextWrapping="Wrap"/><TextBlock Text="Touchpad" Style="{StaticResource Caption}" Margin="0,18,0,5"/><ProgressBar x:Name="TouchX" Minimum="0" Maximum="1" Height="8" Foreground="#7C6CFF"/><ProgressBar x:Name="TouchY" Minimum="0" Maximum="1" Height="8" Margin="0,7,0,0" Foreground="#55D6A5"/><TextBlock Text="Buttons" Style="{StaticResource Caption}" Margin="0,18,0,5"/><TextBlock x:Name="ButtonTesterText" Text="None"/></StackPanel></Border>
                        </WrapPanel>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Profiles" FontSize="28" FontWeight="Light"/><TextBlock Text="Save and reuse lab configurations." Style="{StaticResource Caption}" Margin="0,6,0,18"/><ListBox x:Name="ProfileList" Height="430" Background="#141824" Foreground="#EEF0F7" BorderBrush="#343C50" SelectionChanged="ProfileList_SelectionChanged"/><Button Style="{StaticResource PrimaryButton}" Content="New profile" Click="NewProfile_Click"/><Button Content="Duplicate selected" Click="DuplicateProfile_Click"/><Button Content="Delete selected" Click="DeleteProfile_Click"/></StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="PROFILE DETAILS" Style="{StaticResource SectionTitle}"/><TextBlock Text="Name" Style="{StaticResource Caption}"/><TextBox x:Name="ProfileName"/><TextBlock Text="Assigned executable" Style="{StaticResource Caption}" Margin="0,10,0,0"/><TextBox x:Name="AssignedExecutable" ToolTip="Optional executable name or path used for automatic switching."/><CheckBox x:Name="AutoApply" Content="Automatically apply when executable launches" Margin="0,12" Foreground="#EEF0F7"/><TextBlock x:Name="AutoApplyStatus" Text="Monitoring enabled profiles every 2 seconds." Foreground="#E0B669" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Save profile" Click="SaveProfile_Click"/><Button Content="Export JSON" Margin="10,4,0,4" Click="ExportProfile_Click"/><Button Content="Import JSON" Margin="10,4,0,4" Click="ImportProfile_Click"/></StackPanel></StackPanel></Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Settings" FontSize="28" FontWeight="Light"/><TextBlock Text="Output controls and compatibility notes." Style="{StaticResource Caption}" Margin="0,6,0,20"/>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LIGHT BAR" Style="{StaticResource SectionTitle}"/><TextBlock Text="Hex color" Style="{StaticResource Caption}"/><TextBox x:Name="LightBarColor" Text="#6C63FF" Width="180" HorizontalAlignment="Left"/><Button Content="Apply light-bar color" Width="180" HorizontalAlignment="Left" Click="ApplyLightBar_Click"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CONTROLLER LEDS AND MICROPHONE" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Player LED bitmask (0-31)" Style="{StaticResource Caption}"/><Slider x:Name="PlayerLedsSlider" Minimum="0" Maximum="31" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" Width="360" HorizontalAlignment="Left"/><Button Content="Apply player LEDs" Width="180" HorizontalAlignment="Left" Click="ApplyPlayerLeds_Click"/>
                            <CheckBox x:Name="MicrophoneLedEnabled" Content="Microphone LED enabled" Margin="0,12,0,0" Foreground="#EEF0F7" Checked="MicrophoneLed_Changed" Unchecked="MicrophoneLed_Changed"/>
                            <CheckBox x:Name="MicrophoneLedPulse" Content="Pulse microphone LED" Margin="0,8,0,0" Foreground="#EEF0F7" Checked="MicrophoneLed_Changed" Unchecked="MicrophoneLed_Changed"/>
                            <CheckBox x:Name="MicrophoneMuted" Content="Mute controller microphone" Margin="0,8,0,0" Foreground="#EEF0F7" Checked="MicrophoneMute_Changed" Unchecked="MicrophoneMute_Changed"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AUDIO AND EFFECT TUNING" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Headphone volume (0-127)" Style="{StaticResource Caption}"/><Slider x:Name="HeadphoneVolumeSlider" Minimum="0" Maximum="127" Value="80" TickFrequency="1"/>
                            <TextBlock Text="Speaker volume (0-255)" Style="{StaticResource Caption}"/><Slider x:Name="SpeakerVolumeSlider" Minimum="0" Maximum="255" Value="80" TickFrequency="1"/>
                            <TextBlock Text="Microphone volume (0-64)" Style="{StaticResource Caption}"/><Slider x:Name="MicrophoneVolumeSlider" Minimum="0" Maximum="64" Value="40" TickFrequency="1"/>
                            <TextBlock Text="Speaker preamp gain (0-7)" Style="{StaticResource Caption}"/><Slider x:Name="SpeakerPreampSlider" Minimum="0" Maximum="7" Value="4" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="Effect power reduction (0-7)" Style="{StaticResource Caption}"/><Slider x:Name="EffectPowerReductionSlider" Minimum="0" Maximum="7" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="LED brightness (0 high, 1 medium, 2 low)" Style="{StaticResource Caption}"/><Slider x:Name="LedBrightnessSlider" Minimum="0" Maximum="2" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <CheckBox x:Name="RouteInternalSpeaker" Content="Route audio to internal speaker" Margin="0,8,0,0" Foreground="#EEF0F7"/>
                            <CheckBox x:Name="ForceInternalMicrophone" Content="Force internal microphone" Margin="0,8,0,0" Foreground="#EEF0F7"/>
                            <CheckBox x:Name="ForceHeadsetMicrophone" Content="Force headset microphone" Margin="0,8,0,0" Foreground="#EEF0F7"/>
                            <CheckBox x:Name="AudioMuted" Content="Mute controller audio" Margin="0,8,0,0" Foreground="#EEF0F7"/>
                            <CheckBox x:Name="FadeLightBar" Content="Fade light bar before applying color" Margin="0,8,0,0" Foreground="#EEF0F7"/>
                            <Button Content="Apply audio and effect tuning" Width="230" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ApplyHardwareTuning_Click"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="VIBRATION TEST" Style="{StaticResource SectionTitle}"/><TextBlock Text="Test strength" Style="{StaticResource Caption}"/><Slider x:Name="VibrationSlider" Minimum="0" Maximum="100" Value="20" Width="360" HorizontalAlignment="Left"/><Button Content="Run brief vibration test" Width="200" HorizontalAlignment="Left" Click="TestVibration_Click"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="VIRTUAL XBOX 360 CONTROLLER" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="VirtualOutputEnabled" Content="Enable ViGEmBus virtual-controller output" Foreground="#EEF0F7" Checked="VirtualOutput_Changed" Unchecked="VirtualOutput_Changed"/>
                            <TextBlock x:Name="VirtualOutputStatus" Text="Virtual output is disabled. Enable it after installing ViGEmBus." Foreground="#E0B669" TextWrapping="Wrap" Margin="0,8,0,14"/>
                            <TextBlock Text="With physical HID input active, games receive the mapped controller state. In manual simulator mode, the controls below provide the exact state sent through ViGEm." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="LEFT STICK X" Style="{StaticResource Caption}"/><Slider x:Name="VirtualLeftX" Minimum="-1" Maximum="1" Value="0" TickFrequency=".05" ValueChanged="VirtualController_ValueChanged"/>
                                    <TextBlock Text="LEFT STICK Y" Style="{StaticResource Caption}"/><Slider x:Name="VirtualLeftY" Minimum="-1" Maximum="1" Value="0" TickFrequency=".05" ValueChanged="VirtualController_ValueChanged"/>
                                    <TextBlock Text="LEFT TRIGGER" Style="{StaticResource Caption}"/><Slider x:Name="VirtualLeftTrigger" Minimum="0" Maximum="1" Value="0" TickFrequency=".05" ValueChanged="VirtualController_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RIGHT STICK X" Style="{StaticResource Caption}"/><Slider x:Name="VirtualRightX" Minimum="-1" Maximum="1" Value="0" TickFrequency=".05" ValueChanged="VirtualController_ValueChanged"/>
