                                <CheckBox x:Name="VirtualRB" Content="RB" Tag="RB" Margin="0,0,14,7" Checked="VirtualController_ValueChanged" Unchecked="VirtualController_ValueChanged"/>
                                <CheckBox x:Name="VirtualBack" Content="Back" Tag="Back" Margin="0,0,14,7" Checked="VirtualController_ValueChanged" Unchecked="VirtualController_ValueChanged"/>
                                <CheckBox x:Name="VirtualStart" Content="Start" Tag="Start" Margin="0,0,14,7" Checked="VirtualController_ValueChanged" Unchecked="VirtualController_ValueChanged"/>
                                <CheckBox x:Name="VirtualL3" Content="L3" Tag="L3" Margin="0,0,14,7" Checked="VirtualController_ValueChanged" Unchecked="VirtualController_ValueChanged"/>
                                <CheckBox x:Name="VirtualR3" Content="R3" Tag="R3" Margin="0,0,14,7" Checked="VirtualController_ValueChanged" Unchecked="VirtualController_ValueChanged"/>
                                <CheckBox x:Name="VirtualUp" Content="Up" Tag="Up" Margin="0,0,14,7" Checked="VirtualController_ValueChanged" Unchecked="VirtualController_ValueChanged"/>
                                <CheckBox x:Name="VirtualDown" Content="Down" Tag="Down" Margin="0,0,14,7" Checked="VirtualController_ValueChanged" Unchecked="VirtualController_ValueChanged"/>
                                <CheckBox x:Name="VirtualLeft" Content="Left" Tag="Left" Margin="0,0,14,7" Checked="VirtualController_ValueChanged" Unchecked="VirtualController_ValueChanged"/>
                                <CheckBox x:Name="VirtualRight" Content="Right" Tag="Right" Margin="0,0,14,7" Checked="VirtualController_ValueChanged" Unchecked="VirtualController_ValueChanged"/>
